\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces KDE-Dichteverteilungen der BiLSTM MixUp Regressoren für Leichte Sprache (LS, grün) und Alltagssprache (AS, blau) über verschiedene Kontextlängen: (a) $256$ Tokens, (b) $512$ Tokens und (c) $1.024$ Tokens. Im Gegensatz zum binären Klassifikator weisen die Regressoren bei allen Längen wohlgeformte, breit separierte Verteilungen auf, wobei das $1.024$-Token-Modell die geringste Varianz und schärfste Trennung erzielt.}}{89}{figure.caption.51}\protected@file@percent }
\newlabel{fig:anhang_regressor_kde}{{17}{89}{KDE-Dichteverteilungen der BiLSTM MixUp Regressoren für Leichte Sprache (LS, grün) und Alltagssprache (AS, blau) über verschiedene Kontextlängen: (a) $256$ Tokens, (b) $512$ Tokens und (c) $1.024$ Tokens. Im Gegensatz zum binären Klassifikator weisen die Regressoren bei allen Längen wohlgeformte, breit separierte Verteilungen auf, wobei das $1.024$-Token-Modell die geringste Varianz und schärfste Trennung erzielt}{figure.caption.51}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces ROC- und Precision-Recall-Kurven der BiLSTM MixUp Regressoren ($256$, $512$, $1.024$ Tokens) auf dem Lebenshilfe-Goldstandard. Alle drei Varianten erreichen herausragende Diskriminationswerte ($\text  {ROC-AUC} \ge 0{,}998$, $\text  {PR-AUC} \ge 0{,}997$), wobei die $1.024$-Token-Konfiguration mit $\text  {ROC-AUC} = 0{,}9993$ dominiert.}}{90}{figure.caption.52}\protected@file@percent }
\newlabel{fig:anhang_regressor_roc_pr}{{18}{90}{ROC- und Precision-Recall-Kurven der BiLSTM MixUp Regressoren ($256$, $512$, $1.024$ Tokens) auf dem Lebenshilfe-Goldstandard. Alle drei Varianten erreichen herausragende Diskriminationswerte ($\text {ROC-AUC} \ge 0{,}998$, $\text {PR-AUC} \ge 0{,}997$), wobei die $1.024$-Token-Konfiguration mit $\text {ROC-AUC} = 0{,}9993$ dominiert}{figure.caption.52}{}}
