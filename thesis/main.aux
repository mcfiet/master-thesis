\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Vergleich der Dichteverteilungen (KDE) für Leichte Sprache (LS, grün) und Alltagssprache (AS, blau) über alle Klassifikationsmodi: (a) BiLSTM Satz-Klassifikator (Simple-Sentence-Ratio $r_{LS}$), (b) BiLSTM Artikel-Klassifikator ($256$ Tokens), (c) BiLSTM Artikel-Klassifikator ($512$ Tokens) und (d) BiLSTM Artikel-Klassifikator ($1.024$ Tokens). Man beachte die ausgeprägte Asymmetrie: Während Alltagssprache durch scharfe Peaks bei $0{,}0$ überkonfident separiert wird, bricht die Konfidenz für Leichte Sprache bei längeren Artikelkontexten stark ein.}}{83}{figure.caption.39}\protected@file@percent }
\newlabel{fig:anhang_classifier_kde}{{10}{83}{Vergleich der Dichteverteilungen (KDE) für Leichte Sprache (LS, grün) und Alltagssprache (AS, blau) über alle Klassifikationsmodi: (a) BiLSTM Satz-Klassifikator (Simple-Sentence-Ratio $r_{LS}$), (b) BiLSTM Artikel-Klassifikator ($256$ Tokens), (c) BiLSTM Artikel-Klassifikator ($512$ Tokens) und (d) BiLSTM Artikel-Klassifikator ($1.024$ Tokens). Man beachte die ausgeprägte Asymmetrie: Während Alltagssprache durch scharfe Peaks bei $0{,}0$ überkonfident separiert wird, bricht die Konfidenz für Leichte Sprache bei längeren Artikelkontexten stark ein}{figure.caption.39}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces ROC- und Precision-Recall-Kurven der Klassifikationsmodelle auf dem Lebenshilfe-Goldstandard. Das Satzmodell mit Majority-Voting ($r_{LS}$) erzielt den höchsten AUC-Wert ($0{,}9985$) und übertrifft die direkten Artikelmodelle ($256$, $512$, $1.024$ Tokens) deutlich.}}{84}{figure.caption.40}\protected@file@percent }
\newlabel{fig:anhang_classifier_roc_pr}{{11}{84}{ROC- und Precision-Recall-Kurven der Klassifikationsmodelle auf dem Lebenshilfe-Goldstandard. Das Satzmodell mit Majority-Voting ($r_{LS}$) erzielt den höchsten AUC-Wert ($0{,}9985$) und übertrifft die direkten Artikelmodelle ($256$, $512$, $1.024$ Tokens) deutlich}{figure.caption.40}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Konfusionsmatrizen und relative Performanzmaße der Klassifikatoren: (1) Satz-Modell auf Einzelsatzebene ($N = 6.901$ Sätze), (2) Satz-Modell aggregiert via Majority Voting auf Dokumentebene ($N = 74$ Dokumente), (3) Artikel-Modell auf Dokumentebene sowie (4) vergleichende Gütekriterien im Balkendiagramm.}}{84}{figure.caption.41}\protected@file@percent }
\newlabel{fig:anhang_classifier_confusion}{{12}{84}{Konfusionsmatrizen und relative Performanzmaße der Klassifikatoren: (1) Satz-Modell auf Einzelsatzebene ($N = 6.901$ Sätze), (2) Satz-Modell aggregiert via Majority Voting auf Dokumentebene ($N = 74$ Dokumente), (3) Artikel-Modell auf Dokumentebene sowie (4) vergleichende Gütekriterien im Balkendiagramm}{figure.caption.41}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {9.4}Ergänzende Evaluation der BiLSTM MixUp Regressoren (Längenvergleich \& Trajektorien)}{85}{subsection.9.4}\protected@file@percent }
\newlabel{sec:anhang_regressoren_laengen}{{9.4}{85}{Ergänzende Evaluation der BiLSTM MixUp Regressoren (Längenvergleich \& Trajektorien)}{subsection.9.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces KDE-Dichteverteilungen der BiLSTM MixUp Regressoren für Leichte Sprache (LS, grün) und Alltagssprache (AS, blau) über verschiedene Kontextlängen: (a) $256$ Tokens, (b) $512$ Tokens und (c) $1.024$ Tokens. Im Gegensatz zum binären Klassifikator weisen die Regressoren bei allen Längen wohlgeformte, breit separierte Verteilungen auf, wobei das $1.024$-Token-Modell die geringste Varianz und schärfste Trennung erzielt.}}{85}{figure.caption.42}\protected@file@percent }
\newlabel{fig:anhang_regressor_kde}{{13}{85}{KDE-Dichteverteilungen der BiLSTM MixUp Regressoren für Leichte Sprache (LS, grün) und Alltagssprache (AS, blau) über verschiedene Kontextlängen: (a) $256$ Tokens, (b) $512$ Tokens und (c) $1.024$ Tokens. Im Gegensatz zum binären Klassifikator weisen die Regressoren bei allen Längen wohlgeformte, breit separierte Verteilungen auf, wobei das $1.024$-Token-Modell die geringste Varianz und schärfste Trennung erzielt}{figure.caption.42}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces ROC- und Precision-Recall-Kurven der BiLSTM MixUp Regressoren ($256$, $512$, $1.024$ Tokens) auf dem Lebenshilfe-Goldstandard. Alle drei Varianten erreichen herausragende Diskriminationswerte ($\text  {ROC-AUC} \ge 0{,}998$, $\text  {PR-AUC} \ge 0{,}997$), wobei die $1.024$-Token-Konfiguration mit $\text  {ROC-AUC} = 0{,}9993$ dominiert.}}{86}{figure.caption.43}\protected@file@percent }
\newlabel{fig:anhang_regressor_roc_pr}{{14}{86}{ROC- und Precision-Recall-Kurven der BiLSTM MixUp Regressoren ($256$, $512$, $1.024$ Tokens) auf dem Lebenshilfe-Goldstandard. Alle drei Varianten erreichen herausragende Diskriminationswerte ($\text {ROC-AUC} \ge 0{,}998$, $\text {PR-AUC} \ge 0{,}997$), wobei die $1.024$-Token-Konfiguration mit $\text {ROC-AUC} = 0{,}9993$ dominiert}{figure.caption.43}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Paarweises Profil der Regressions-Scores und Textlängen-Einfluss: (a) Direkte Gegenüberstellung der vorhergesagten Scores für alle $37$ parallelen Lebenshilfe-Artikelpaare ($\text  {LS} > \text  {AS}$ bei allen Paaren, $100\,\%$ Perfect Pair Match beim $1.024$-Modell) sowie (b) Korrelation zwischen Dokumentenlänge (Satzanzahl) und resultierendem Einfachheits-Score.}}{86}{figure.caption.44}\protected@file@percent }
\newlabel{fig:anhang_regressor_trajectories}{{15}{86}{Paarweises Profil der Regressions-Scores und Textlängen-Einfluss: (a) Direkte Gegenüberstellung der vorhergesagten Scores für alle $37$ parallelen Lebenshilfe-Artikelpaare ($\text {LS} > \text {AS}$ bei allen Paaren, $100\,\%$ Perfect Pair Match beim $1.024$-Modell) sowie (b) Korrelation zwischen Dokumentenlänge (Satzanzahl) und resultierendem Einfachheits-Score}{figure.caption.44}{}}
